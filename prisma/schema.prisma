generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String            @db.VarChar(36) @id @default(uuid())
  nome             String            @db.VarChar(50)
  email            String            @db.VarChar(100) @unique()
  senha            String            @db.VarChar(60)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  perfil           Perfil            @relation(fields: [perfilId], references: [id])
  perfilId         Int
  agendamentos     AgendamentoTreino[]
  logs             Log[]
  perguntaSecreta  String?           @db.VarChar(100)
  respostaSecreta  String?           @db.VarChar(200)
  @@map("usuarios")
}

model Perfil {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(50)
  permissoes  String?   @db.VarChar(200) // você pode colocar uma lista ou JSON de permissões
  usuarios    Usuario[]
  @@map("perfis")
}

model Treino {
  id            Int       @id @default(autoincrement())
  descricao     String
  dataInicio    DateTime
  ativo         Boolean   @default(true)
  exercicios    TreinoExercicio[]
  agendamentos  AgendamentoTreino[]
}

model Exercicio {
  id             Int       @id @default(autoincrement())
  nome           String
  grupoMuscular  String
  descricao      String?
  treinos        TreinoExercicio[]
}

model TreinoExercicio {
  id            Int       @id @default(autoincrement())
  treino        Treino    @relation(fields: [treinoId], references: [id])
  treinoId      Int
  exercicio     Exercicio @relation(fields: [exercicioId], references: [id])
  exercicioId   Int
  series        Int
  repeticoes    Int
  carga         Float?
}

model AgendamentoTreino {
  id          Int       @id @default(autoincrement())
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId   String    @db.VarChar(36)
  treino      Treino    @relation(fields: [treinoId], references: [id])
  treinoId    Int
  status      String    @db.VarChar(20) // ex: "pendente", "concluido", "cancelado"
  dataCriacao DateTime  @default(now())
  dataAgendada DateTime
  observacoes String?   @db.VarChar(200)
  @@map("agendamentos_treino")
}

model Log {
  id            Int         @id @default(autoincrement())
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  usuarioId     String      @db.VarChar(36)
  descricao     String      @db.VarChar(60)
  complemento   String      @db.VarChar(200)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@map("logs")
}
